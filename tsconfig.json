{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleSuffixes": [".ios", ".android", ".native", ""],
    "lib": ["dom", "esnext"],
    "types": ["node", "jest"],
    "paths": {
      "#/*": ["./src/*"],

      "crypto": ["./src/platform/crypto.ts"],
      /*
       * Expo file-system and image-manipulator do not export their build
       * paths, which are needed for web-only types. View-shot's declarations
       * avoid checking its raw sources against React Native 0.88.
       */
      "expo-file-system/build/*": ["./node_modules/expo-file-system/build/*"],
      "expo-image-manipulator/build/*": ["./node_modules/expo-image-manipulator/build/*"],
      "react-native-view-shot": ["./node_modules/react-native-view-shot/lib/index.d.ts"],
    },
    "plugins": [
      {
        "name": "ts-plugin-sort-import-suggestions",
        "moveUpPatterns": ["#/", "@lingui/react/macro"],
        "moveDownPatterns": ["react-native-reanimated/lib"]
      }
    ]
    },
  "exclude": ["bskyweb", "bskyembed", "web-build"]
}
