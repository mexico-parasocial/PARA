# PARA app environment — copy to .env and fill in. All EXPO_PUBLIC_* vars are
# inlined into the JS bundle at build time (they are not secrets).

# App environment: development | testflight | production | e2e
EXPO_PUBLIC_ENV=development

# m8 proof broker (mubEZ) — identity wallet, grants, INE/ZKP, karma, votes.
# Default when unset: http://127.0.0.1:8787 (http://10.0.2.2:8787 on Android
# emulator). Point this at your mubEZ instance; the client appends /v1.
EXPO_PUBLIC_M8_BROKER_URL=http://127.0.0.1:8787

# Matrix chat bridge used for community chat
EXPO_PUBLIC_MATRIX_BRIDGE_URL=https://bridge.para.social

# Local atproto dev services (see src/lib/constants.ts)
# Physical devices: your dev machine's LAN IP (ipconfig getifaddr en0).
# EXPO_PUBLIC_LOCAL_DEV_IP=192.168.x.x
# Full override of the local dev PDS URL, if you need one:
# EXPO_PUBLIC_LOCAL_DEV_SERVICE=http://192.168.x.x:2583
# EXPO_PUBLIC_API_URL=https://api.example.com
